<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross browser" parallel="tests" thread-count="2" data-provider-thread-count="2">
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <groups><run><include name="ui"/></run></groups>
        <packages>
            <package name="com.portfolio.automation.ui"/>
            <package name="com.portfolio.automation.responsive"/>
            <package name="com.portfolio.automation.accessibility"/>
        </packages>
    </test>
    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <groups><run><include name="ui"/></run></groups>
        <packages>
            <package name="com.portfolio.automation.ui"/>
            <package name="com.portfolio.automation.responsive"/>
            <package name="com.portfolio.automation.accessibility"/>
        </packages>
    </test>
</suite>
